---
// Abstract arched portrait. Not a likeness of anyone: shapes and a silhouette.
interface Props {
  variant: 0 | 1 | 2 | 3;
}
const { variant } = Astro.props;

const themes = [
  { bg: '#26685a', motif: '#3f8a79', fig: '#edf3f0', hair: '#0f2a3b' },
  { bg: '#0f2a3b', motif: '#1f4760', fig: '#f2c447', hair: '#edf3f0' },
  { bg: '#f2c447', motif: '#e2ad2a', fig: '#0f2a3b', hair: '#26685a' },
  { bg: '#c7a97a', motif: '#b4935f', fig: '#0f2a3b', hair: '#f8fbf9' },
] as const;
const t = themes[variant];
const id = `arch-${variant}`;

const waves = Array.from({ length: 9 }, (_, i) => {
  const y = 30 + i * 24;
  return `M-10 ${y}c20-10 30-10 50 0s30 10 50 0 30-10 50 0 30 10 50 0 30-10 50 0`;
});
const kelp = Array.from({ length: 7 }, (_, i) => {
  const x = 10 + i * 30;
  return `M${x} 250c-12-30 12-50 0-80s12-50 0-80 12-50 0-80`;
});
---
<svg viewBox="0 0 200 240" aria-hidden="true" class="avatar">
  <defs>
    <clipPath id={id}>
      <path d="M0 240V100A100 100 0 0 1 200 100V240Z" />
    </clipPath>
  </defs>
  <g clip-path={`url(#${id})`}>
    <rect width="200" height="240" fill={t.bg} />

    {variant === 0 && <g fill="none" stroke={t.motif} stroke-width="6">{waves.map((d) => <path d={d} />)}</g>}
    {
      variant === 1 && (
        <g fill="none" stroke={t.motif} stroke-width="8">
          {[30, 52, 74, 96, 118].map((r) => <circle cx="100" cy="112" r={r} />)}
        </g>
      )
    }
    {
      variant === 2 && (
        <g fill={t.motif}>
          {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <rect x={-40 + i * 36} y="-20" width="16" height="300" transform="rotate(24 100 120)" />)}
        </g>
      )
    }
    {variant === 3 && <g fill="none" stroke={t.motif} stroke-width="7" stroke-linecap="round">{kelp.map((d) => <path d={d} />)}</g>}

    <!-- silhouette: back hair, shoulders, neck, head, then front hair -->
    {variant === 0 && <path fill={t.hair} d="M70 104c0-34 14-50 30-50s30 16 30 50v52H70Z" />}
    {variant === 2 && <circle cx="100" cy="66" r="20" fill={t.hair} />}
    {variant === 3 && <circle cx="124" cy="78" r="15" fill={t.hair} />}

    <path fill={t.fig} d="M30 240c0-56 30-90 70-90s70 34 70 90Z" />
    <path fill={t.fig} d="M89 128h22v26H89Z" />
    <ellipse cx="100" cy="106" rx="25" ry="30" fill={t.fig} transform={variant === 2 ? 'rotate(-6 100 106)' : variant === 3 ? 'rotate(5 100 106)' : undefined} />

    {variant === 0 && <path fill={t.hair} d="M74 104c-2-22 10-34 26-34s28 12 26 34c-8-12-24-18-52 0Z" />}
    {variant === 1 && <path fill={t.hair} d="M75 100c-2-20 8-30 25-30s27 10 25 30c-6-8-16-12-25-12s-19 4-25 12Z" />}
    {variant === 2 && <path fill={t.hair} d="M75 102c-2-22 10-32 25-32s27 10 25 32c-10-10-30-14-50 0Z" transform="rotate(-6 100 106)" />}
    {variant === 3 && <path fill={t.hair} d="M75 100c0-20 10-30 25-30 18 0 28 12 25 32-10-14-30-16-50-2Z" transform="rotate(5 100 106)" />}
    {variant === 1 && <path fill={t.bg} opacity="0.35" d="M86 154l14 24 14-24Z" />}
  </g>
</svg>

<style>
  .avatar {
    width: 100%;
    height: auto;
  }
</style>
