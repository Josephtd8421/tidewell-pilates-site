---
import { testimonials } from '../data/site';
const [lead, ...rest] = testimonials;
---
<section class="section voices" aria-labelledby="voices-title">
  <div class="wrap">
    <h2 id="voices-title">What members say</h2>

    <div class="grid">
      <figure class="lead">
        <blockquote><p>{lead.quote}</p></blockquote>
        <figcaption>{lead.who}, {lead.since}</figcaption>
      </figure>
      <div class="rest">
        {
          rest.map((t) => (
            <figure>
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption>{t.who}, {t.since}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
    <p class="note">Sample reviews written for this portfolio demo. They are not from real customers.</p>
  </div>
</section>

<style>
  .voices {
    background: var(--band);
    color: var(--band-ink);
    position: relative;
    overflow: hidden;
  }

  h2 {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  figure {
    margin: 0;
  }

  blockquote {
    margin: 0;
  }

  .lead blockquote {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.22;
  }

  .lead blockquote p::before {
    content: '\201C';
    color: var(--buoy);
  }
  .lead blockquote p::after {
    content: '\201D';
    color: var(--buoy);
  }

  .rest {
    display: grid;
    gap: 2rem;
  }

  .rest figure {
    border-top: 1px solid var(--band-rule);
    padding-top: 1.5rem;
  }

  .rest blockquote {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  figcaption {
    margin-top: 1rem;
    color: var(--band-soft);
    font-size: var(--step--1);
  }

  .note {
    margin-top: 3rem;
    font-size: var(--step--1);
    color: var(--band-soft);
  }
</style>
