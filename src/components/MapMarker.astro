---
// Studio buoy marker with a leader line and label, for use inside an SVG map.
interface Props {
  x: number;
  y: number;
  /** Buoy radius; the dashed ring is drawn at twice this. */
  r?: number;
  label: string;
  /** SVG path for the leader line, in the parent map's coordinates. */
  leader: string;
  labelX: number;
  labelY: number;
  /**
   * bob: rock gently while on screen (motion.ts pauses it off screen).
   * settle: drop in and swing to rest once, when an ancestor [data-reveal] turns "in".
   */
  motion?: 'bob' | 'settle';
}
const { x, y, r = 13, label, leader, labelX, labelY, motion } = Astro.props;
---
<g class="map-marker" data-ambient={motion === 'bob' ? 'off' : undefined} data-settle={motion === 'settle' || undefined}>
  <circle class="ring" cx={x} cy={y} r={r * 2} />
  <g class="float">
    <circle class="buoy" cx={x} cy={y} r={r} />
    <path class="band" d={`M${x - r} ${y}H${x + r}`} />
  </g>
  <path class="leader" d={leader} />
  <text x={labelX} y={labelY}>{label}</text>
</g>

<style>
  .ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .buoy {
    fill: var(--buoy);
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .band {
    stroke: var(--ink);
    stroke-width: 4;
  }
  .leader {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  /* Bob is slow enough to read as water, not as a loading indicator. Settle
     uses the shared keyframes in global.css (as the hero compass needle does)
     and starts once the map's contours are drawing. */
  .float {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    --settle-angle: -10deg;
    --settle-lift: -8px;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-ambient='on'] .float {
      animation: buoy-bob 7s ease-in-out infinite;
    }
    :global([data-reveal='in']) [data-settle] .float {
      animation: settle 1.6s var(--ease-settle) 0.5s both;
    }
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    :global([data-reveal='pending']) [data-settle] .float {
      transform: translateY(var(--settle-lift)) rotate(var(--settle-angle));
    }
  }
  @keyframes buoy-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-2px) rotate(2deg);
    }
  }
  text {
    font-family: var(--font-display);
    font-size: var(--marker-label-size, 20px);
    fill: var(--ink);
  }
</style>
