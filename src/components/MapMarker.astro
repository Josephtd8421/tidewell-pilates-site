---
// Studio buoy marker with a leader line and label, for use inside an SVG map.
interface Props {
  x: number;
  y: number;
  /** Buoy radius; the dashed ring is drawn at twice this. */
  r?: number;
  label: string;
  /** SVG path for the leader line, in the parent map's coordinates. */
  leader: string;
  labelX: number;
  labelY: number;
  /** Let the buoy bob gently while on screen. Use on one marker per page at most. */
  bob?: boolean;
}
const { x, y, r = 13, label, leader, labelX, labelY, bob = false } = Astro.props;
---
<g class="map-marker" data-ambient={bob ? 'off' : undefined}>
  <circle class="ring" cx={x} cy={y} r={r * 2} />
  <g class="float">
    <circle class="buoy" cx={x} cy={y} r={r} />
    <path class="band" d={`M${x - r} ${y}H${x + r}`} />
  </g>
  <path class="leader" d={leader} />
  <text x={labelX} y={labelY}>{label}</text>
</g>

<style>
  .ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .buoy {
    fill: var(--buoy);
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .band {
    stroke: var(--ink);
    stroke-width: 4;
  }
  .leader {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  /* Slow enough to read as water, not as a loading indicator. Runs only while
     motion.ts reports the marker on screen. */
  .float {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-ambient='on'] .float {
      animation: buoy-bob 7s ease-in-out infinite;
    }
  }
  @keyframes buoy-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-2px) rotate(2deg);
    }
  }
  text {
    font-family: var(--font-display);
    font-size: var(--marker-label-size, 20px);
    fill: var(--ink);
  }
</style>
