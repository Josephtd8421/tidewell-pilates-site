---
import { schedule, classTypes } from '../data/site';

const byId = Object.fromEntries(classTypes.map((c) => [c.id, c]));
const fmt = (t: string) => {
  const [h, m] = t.split(':').map(Number);
  const suffix = h >= 12 ? 'pm' : 'am';
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return { label: `${h12}:${String(m).padStart(2, '0')}`, suffix };
};
---
<section id="timetable" class="section timetable" aria-labelledby="tt-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="tt-title">This week's timetable</h2>
      <p>Classes run every day of the week. Book up to 14 days ahead; the waitlist opens when a class fills.</p>
    </div>

    <ul class="key" aria-label="Class colours">
      {classTypes.map((c) => <li><span class="dot" style={`--k: ${c.swatch}`} aria-hidden="true"></span>{c.name}</li>)}
    </ul>

    <div class="tt" data-tt data-reveal>
      <div class="tabs" role="tablist" aria-label="Day of the week" hidden>
        {
          schedule.map((d) => (
            <button type="button" role="tab" id={`tab-${d.id}`} aria-controls={`day-${d.id}`} aria-selected="false" tabindex="-1">
              <span aria-hidden="true">{d.short}</span>
              <span class="visually-hidden">{d.long}</span>
            </button>
          ))
        }
      </div>

      <div class="days">
        {
          schedule.map((d, di) => (
            <section class="day" id={`day-${d.id}`} aria-labelledby={`h-${d.id}`} style={`--d: ${di}`}>
              <h3 id={`h-${d.id}`}>{d.long}</h3>
              <ol>
                {d.sessions.map((s, si) => {
                  const t = fmt(s.time);
                  return (
                    <li style={`--k: ${byId[s.classId].swatch}; --n: ${si}`}>
                      <time datetime={s.time.padStart(5, '0')}>
                        {t.label}
                        <small>{t.suffix}</small>
                      </time>
                      <span class="cls">{byId[s.classId].name}</span>
                      <span class="who">with {s.teacher}</span>
                    </li>
                  );
                })}
              </ol>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Mobile: turn the stacked days into tabs. Desktop: a seven-column grid, no tabs.
  const root = document.querySelector<HTMLElement>('[data-tt]');
  if (root) {
    const tablist = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.day'));
    const mq = window.matchMedia('(max-width: 55.99rem)');
    const today = (new Date().getDay() + 6) % 7; // Monday = 0
    let current = today;

    const select = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, j) => {
        const on = j === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
    };

    const apply = () => {
      if (mq.matches) {
        tablist.hidden = false;
        panels.forEach((p, j) => {
          p.setAttribute('role', 'tabpanel');
          p.setAttribute('aria-labelledby', tabs[j].id);
          p.tabIndex = 0;
        });
        select(current);
      } else {
        tablist.hidden = true;
        panels.forEach((p) => {
          p.hidden = false;
          p.removeAttribute('role');
          p.setAttribute('aria-labelledby', `h-${p.id.slice(4)}`);
          p.removeAttribute('tabindex');
        });
      }
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        if (e.key === 'ArrowRight') select((i + 1) % n, true);
        else if (e.key === 'ArrowLeft') select((i - 1 + n) % n, true);
        else if (e.key === 'Home') select(0, true);
        else if (e.key === 'End') select(n - 1, true);
        else return;
        e.preventDefault();
      });
    });

    mq.addEventListener('change', apply);
    apply();
  }
</script>

<style>
  .timetable {
    background: var(--paper-2);
    border-block: 1px solid var(--rule);
  }

  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    font-size: var(--step--1);
  }

  .key li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--k);
    border: 1.5px solid var(--ink);
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .tabs[hidden] {
    display: none;
  }

  .tabs button {
    min-height: 2.9rem;
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font: 700 var(--step--1) / 1 var(--font-body);
    cursor: pointer;
    padding: 0;
  }

  .tabs button[aria-selected='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .days {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 56rem) {
    .days {
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0;
      border: 1.5px solid var(--ink);
      background: var(--surface);
    }
    .day + .day {
      border-left: 1px solid var(--rule);
    }
  }

  .day {
    background: var(--surface);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
  }

  @media (min-width: 56rem) {
    .day {
      border: 0;
      border-radius: 0;
    }
  }

  .day h3 {
    font-size: var(--step-1);
    padding: 0.9rem 1rem 0.8rem;
    border-bottom: 1.5px solid var(--ink);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .day li {
    display: grid;
    grid-template-columns: 4.6rem 1fr;
    gap: 0 0.75rem;
    padding: 0.85rem 1rem 0.85rem 0.85rem;
    border-left: 6px solid var(--k);
  }

  .day li + li {
    border-top: 1px solid var(--rule);
  }

  time {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
    font-variant-numeric: lining-nums tabular-nums;
  }

  time small {
    font-family: var(--font-body);
    font-size: 0.7rem;
    margin-left: 0.15rem;
    color: var(--ink-soft);
  }

  .cls {
    font-weight: 700;
    line-height: 1.3;
  }

  .who {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  @media (min-width: 56rem) {
    .day li {
      grid-template-columns: 1fr;
      padding: 0.8rem 0.7rem 0.9rem 0.65rem;
      border-left-width: 4px;
    }
    time {
      grid-row: auto;
      font-size: var(--step-1);
    }
    .cls {
      font-size: var(--step--1);
      margin-top: 0.2rem;
    }
    .who {
      font-size: 0.8rem;
    }
    .day h3 {
      font-size: var(--step-0);
      font-family: var(--font-body);
      font-weight: 700;
    }
  }

  /* Sessions fill in down each column, columns a beat apart, like a departure
     board. Only ever applied below the fold; see src/scripts/motion.ts.
     Transitions rather than keyframes so a mobile tab switch (display: none to
     shown) does not replay it. */
  @media screen and (prefers-reduced-motion: no-preference) {
    .tt[data-reveal='pending'] .day li {
      opacity: 0;
      transform: translateY(6px);
    }
    .tt[data-reveal='in'] .day li {
      transition:
        opacity 420ms ease-out,
        transform 420ms cubic-bezier(0.2, 0.7, 0.3, 1);
      transition-delay: calc(var(--d, 0) * 45ms + var(--n, 0) * 60ms);
    }
  }
  @media screen and (max-width: 55.99rem) {
    .day {
      --d: 0;
    }
  }
</style>
