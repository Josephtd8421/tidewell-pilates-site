---
import { navLinks } from '../data/site';
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Tidewell Pilates, home">
      <svg viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
        <circle cx="20" cy="18" r="11" fill="var(--buoy)" stroke="var(--ink)" stroke-width="2" />
        <path d="M9 18h22" stroke="var(--ink)" stroke-width="2.5" />
        <path d="M3 32c4-3 7-3 11 0s7 3 11 0 7-3 11 0" fill="none" stroke="var(--kelp)" stroke-width="2.5" stroke-linecap="round" />
      </svg>
      <span>Tidewell Pilates</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      Menu
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {navLinks.filter((l) => !l.footerOnly).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <a class="btn btn-buoy nav-cta" href="#book">Book a free class</a>
    </nav>
  </div>
</header>

<script>
  // Without JS the nav wraps under the logo; the .js class is set inline in <head> to avoid a layout shift.
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        set(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    min-height: 4.25rem;
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav ul a {
    text-decoration: none;
    padding-block: 0.5rem;
    display: inline-block;
  }

  .nav ul a:hover {
    text-decoration: underline;
  }

  .nav-cta {
    min-height: 2.6rem;
    padding: 0.5rem 1.1rem;
    font-size: var(--step--1);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 56rem) {
    .nav {
      width: 100%;
      justify-content: space-between;
      padding-bottom: 0.5rem;
    }
    .nav-cta {
      display: none;
    }

    :global(.js) .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      padding: 0.4rem 0.9rem;
      border: 2px solid var(--ink);
      border-radius: 999px;
      background: transparent;
      color: var(--ink);
      font: 700 var(--step--1) / 1 var(--font-body);
      cursor: pointer;
    }

    .menu-icon,
    .menu-icon::before {
      display: block;
      width: 1.1rem;
      height: 2px;
      background: currentColor;
      position: relative;
    }
    .menu-icon::before {
      content: '';
      position: absolute;
      top: 6px;
    }
    .menu-icon {
      margin-top: -6px;
    }

    :global(.js) .nav {
      display: none;
    }
    :global(.js) .nav.is-open {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 0.5rem 0 1.25rem;
    }
    :global(.js) .nav.is-open ul {
      flex-direction: column;
      gap: 0;
    }
    :global(.js) .nav.is-open ul a {
      display: block;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--rule);
      font-size: var(--step-1);
    }
    :global(.js) .nav.is-open .nav-cta {
      display: inline-flex;
      font-size: var(--step-0);
      min-height: 3rem;
    }
  }
</style>
