---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Classes from '../components/Classes.astro';
import Schedule from '../components/Schedule.astro';
import Instructors from '../components/Instructors.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import Visit from '../components/Visit.astro';
import Faq from '../components/Faq.astro';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Tidewell Pilates | Small reformer classes in Larkhaven, first class free"
  description="Boutique reformer and mat Pilates above Larkhaven harbor. Eight machines per class, classes every day, and your first class is free."
>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Classes />
    <Schedule />
    <Instructors />
    <Pricing />
    <Testimonials />
    <Visit />
    <Faq />
    <Booking />
  </main>
  <Footer />
</Base>
